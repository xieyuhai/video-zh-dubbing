# Configure one translation provider for contextual translation and Mandarin polish.
# Optional installed Ollama model. When set, auto mode prefers local translation.
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Chinese speech provider when Edge TTS is unavailable.
DASHSCOPE_API_KEY=

# Optional local CosyVoice backend; no speech API calls.
COSYVOICE_PYTHON=
COSYVOICE_REPO=
COSYVOICE_MODEL_DIR=
